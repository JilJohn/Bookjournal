export type BookStatus = 'read' | 'reading' | 'planned';

export type DrawingVariant = 'circle' | 'zigzag' | 'star' | 'square';

export interface Note {
  id: string;
  content: string;
  type: 'note' | 'quote' | 'reflection';
  date: string;
}

export interface Book {
  id: string;
  title: string;
  author: string;
  genre: string;
  year: number;
  status: BookStatus;
  dateAdded: string;
  dateFinished?: string;
  notes: Note[];
  coverColor?: string;
  drawingVariant?: DrawingVariant;
  coverImage?: string;
}
