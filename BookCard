import { Book } from '../types';
import { Eye, Edit, Trash2, StickyNote } from 'lucide-react';
import { HandDrawnCircle } from './HandDrawnCircle';

interface BookCardProps {
  book: Book;
  onViewBook: (id: string) => void;
  onView: () => void;
  onEdit: () => void;
  onDelete: () => void;
  onUpdateBook: (book: Book) => void;
}

const statusColors = {
  read: 'bg-gray-100 text-black border-gray-300',
  reading: 'bg-gray-100 text-black border-gray-300',
  planned: 'bg-gray-100 text-black border-gray-300'
};

const statusLabels = {
  read: 'Gelesen',
  reading: 'Lese ich',
  planned: 'Geplant'
};

const variants = ['circle', 'square', 'star', 'zigzag'] as const;

export function BookCard({ book, onViewBook, onView, onEdit, onDelete, onUpdateBook }: BookCardProps) {
  const currentVariant = book.drawingVariant || 'circle';

  const handleTitleClick = () => {
    const currentIndex = variants.indexOf(currentVariant);
    const nextIndex = (currentIndex + 1) % variants.length;
    const nextVariant = variants[nextIndex];
    
    onUpdateBook({
      ...book,
      drawingVariant: nextVariant
    });
  };

  return (
    <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
      {/* Book Cover */}
      <div className="bg-white h-48 flex items-center justify-center p-6 relative border-b border-gray-200">
        <HandDrawnCircle variant={currentVariant} className="text-black">
          <div 
            className="text-black text-center px-6 py-4 cursor-pointer"
            onClick={handleTitleClick}
          >
            <p className="line-clamp-2 mb-1" style={{ fontWeight: 800, fontSize: '1.1rem' }}>
              {book.title}
            </p>
            <p className="text-sm" style={{ fontWeight: 400 }}>
              {book.author}
            </p>
          </div>
        </HandDrawnCircle>
        {book.notes.length > 0 && (
          <div className="absolute top-3 right-3 bg-gray-100 rounded-full p-2">
            <StickyNote className="size-4 text-black" />
          </div>
        )}
      </div>

      {/* Book Info */}
      <div className="p-4 space-y-3">
        <div>
          <h3 className="text-gray-900 line-clamp-1 mb-1" style={{ fontWeight: 800 }}>
            {book.title}
          </h3>
          <p className="text-gray-600 text-sm">{book.author}</p>
        </div>

        <div className="flex items-center justify-between text-sm">
          <span className="text-gray-500">{book.genre}</span>
          <span className="text-gray-500">{book.year}</span>
        </div>

        <div className={⁠ inline-block px-3 py-1 rounded-full text-sm border ${statusColors[book.status]} ⁠}>
          {statusLabels[book.status]}
        </div>

        {/* Actions */}
        <div className="flex gap-2 pt-2">
          <button
            onClick={onView}
            className="flex-1 bg-black hover:bg-gray-800 text-white py-2 px-3 rounded-lg flex items-center justify-center gap-2 transition-colors text-sm"
            style={{ fontWeight: 600 }}
          >
            <Eye className="size-4" />
            Ansehen
          </button>
          <button
            onClick={onEdit}
            className="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors"
            title="Bearbeiten"
          >
            <Edit className="size-4" />
          </button>
          <button
            onClick={() => {
              if (confirm('Möchten Sie dieses Buch wirklich löschen?')) {
                onDelete();
              }
            }}
            className="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
            title="Löschen"
          >
            <Trash2 className="size-4" />
          </button>
        </div>
      </div>
    </div>
  );
}
